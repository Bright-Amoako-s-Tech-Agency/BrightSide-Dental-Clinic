# =============================================================================
# BrightSide Dental Clinic — Backend Environment Configuration
# =============================================================================

PORT=5000
NODE_ENV=development

# -----------------------------------------------------------------------------
# Supabase Database Configuration
# -----------------------------------------------------------------------------
# Found in: Supabase Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
# Service Role Key (secret): Bypasses RLS for secure backend operations
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# -----------------------------------------------------------------------------
# Frontend Application URL (for CORS)
# -----------------------------------------------------------------------------
CLIENT_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Paystack — Ghana Mobile Money & Card Payments
# -----------------------------------------------------------------------------
# Get your keys from: https://dashboard.paystack.com/#/settings/developers
# Use sk_test_... for sandbox / sk_live_... for production.
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here
PAYSTACK_WEBHOOK_URL=https://your-domain.com/api/payments/webhook

# -----------------------------------------------------------------------------
# Staff Portal Security Key
# -----------------------------------------------------------------------------
# Used to secure staff-only endpoints against unauthorized public access
STAFF_SECRET_KEY=brightsmile-staff-demo-key

# -----------------------------------------------------------------------------
# Resend Email Configuration (Optional / Confirmation Emails)
# -----------------------------------------------------------------------------
# RESEND_API_KEY=re_your_resend_api_key
