# =============================================================================
# BrightSide Dental Clinic — Frontend Environment Configuration
# =============================================================================

# Base URL pointing to the deployed backend Express API
# Local dev: http://localhost:5000/api
# Production: https://api.yourdomain.com/api
VITE_API_URL=http://localhost:5000/api

# Staff Portal Authorization Key (must match STAFF_SECRET_KEY on the backend)
VITE_STAFF_KEY=brightsmile-staff-demo-key
